{
	"extends": ["conventional"],
	"ignores": ["^(Revert|Reapply)\\s+\""],
	"rules": {
		"subject-empty": [2, "never"],
		"subject-full-stop": [2, "never", "."],
		"type-case": [2, "always", ["lower-case"]],
		"scope-case": [2, "always", ["lower-case"]],
		"header-max-length": [2, "always", 256],
		"type-enum": [
			2,
			"always",
			[
				"build",
				"chore",
				"ci",
				"docs",
				"feat",
				"fix",
				"perf",
				"refactor",
				"revert",
				"style",
				"test"
			]
		]
	}
}
